{
  "name": "commissioner-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "auth:setup": "node scripts/create-local-env.cjs",
    "db:migrate": "npx tsx scripts/run-migration.ts",
    "db:seed": "npx tsx scripts/seed-db.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "build:ds-css": "sass --no-source-map --no-charset --style=compressed --load-path=node_modules/nhsuk-frontend/packages app/styles/_src/nhsuk-theme.scss app/styles/nhsuk-theme.generated.css && sass --no-source-map --no-charset --style=compressed --quiet --load-path=node_modules/nhsuk-frontend-v10/dist app/styles/_src/nhsuk-v10-gaps.scss app/styles/nhsuk-v10-gaps.generated.css && sass --no-source-map --no-charset --style=compressed --quiet --load-path=node_modules/govuk-frontend/dist app/styles/_src/govuk-gaps.scss app/styles/govuk-gaps.generated.css",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "prebuild": "npm run build:ds-css",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fuse.js": "^7.1.0",
    "govuk-frontend": "^6.3.0",
    "iron-session": "^8.0.4",
    "jose": "^6.2.2",
    "lucide-react": "^0.577.0",
    "next": "16.1.7",
    "nhsuk-frontend": "^9.6.4",
    "nhsuk-frontend-v10": "npm:nhsuk-frontend@^10.6.1",
    "openai": "^6.39.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "sass": "^1.101.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
